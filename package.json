{
  "name": "@43081j/omni-todo",
  "version": "0.0.0-dev",
  "private": true,
  "description": "A todo list built with too many web frameworks.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:types": "tsc",
    "lint:js": "oxlint src",
    "lint:format": "oxfmt --check src",
    "lint:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "npm run lint:types && npm run lint:svelte && npm run lint:js && npm run lint:format",
    "format": "oxfmt --write src",
    "test": "vitest run"
  },
  "author": "James Garbutt (https://github.com/43081j)",
  "license": "MIT",
  "homepage": "https://github.com/43081j/omni-todo#readme",
  "bugs": {
    "url": "https://github.com/43081j/omni-todo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/43081j/omni-todo.git"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.5",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "playwright": "^1.62.1",
    "svelte-check": "^4.7.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "preact": "^10.29.8",
    "preact-custom-element": "^4.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solid-element": "^1.9.2",
    "solid-js": "^1.9.14",
    "svelte": "^5.56.8",
    "vue": "^3.5.41"
  }
